// This is your Prisma schema file for CivicLens
// Configured with SQLite for zero-friction local execution, with easy switch to Postgres/PostGIS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  role         String   @default("CITIZEN") // CITIZEN, FIELD_STAFF, MUNICIPAL_ADMIN, ZONAL_SUPERVISOR
  wardId       String?
  departmentId String?
  badgeNumber  String?
  createdAt    DateTime @default(now())
}

model Ward {
  id                String   @id @default(cuid())
  code              String   @unique // WARD-101
  name              String   // Central Civic Ward
  zone              String   // Zone A - Urban Core
  boundariesGeoJson String   // GeoJSON polygon coordinates serialized
  centerLat         Float
  centerLng         Float
  officerName       String
  officerPhone      String
  officerEmail      String
  emergencyContact  String
  createdAt         DateTime @default(now())
  tickets           Ticket[]
}

model Department {
  id             String   @id @default(cuid())
  code           String   @unique // SANITATION, PUBLIC_WORKS, WATER_SUPPLY, STREET_LIGHTING
  name           String
  description    String
  slaHoursNormal Int      @default(72)
  slaHoursUrgent Int      @default(24)
  icon           String   @default("wrench")
  createdAt      DateTime @default(now())
  tickets        Ticket[]
}

model Ticket {
  id                    String        @id @default(cuid())
  caseId                String        @unique // e.g. CVL-2026-W101-0842
  legacyGrievanceNumber String        // e.g. MGM-GR-9921
  title                 String
  description           String
  category              String        // e.g. Pothole & Road Damage, Water Leakage / Pipe Burst
  urgency               String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  plainLanguageRights   String
  status                String        @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, PROVISIONALLY_RESOLVED, RESOLVED, DISPUTED, CLOSED
  
  // Geolocation
  latitude              Float
  longitude             Float
  addressDescription    String
  
  // Relations
  wardId                String
  ward                  Ward          @relation(fields: [wardId], references: [id])
  departmentId          String
  department            Department    @relation(fields: [departmentId], references: [id])
  
  // Citizen Info (Masked in public view)
  citizenName           String
  citizenPhone          String
  
  // Operational details
  assignedOfficerId     String?
  assignedOfficerName   String?
  publicCommitmentDate  DateTime
  slaDeadline           DateTime
  
  // Multimodal initial uploads
  initialPhotoUrl       String?
  initialAudioUrl       String?
  
  // Proof of Work (Two-Stage Resolution Gate)
  resolutionPhotoUrl    String?
  resolutionGpsLat      Float?
  resolutionGpsLng      Float?
  resolutionTimestamp   DateTime?
  resolutionNotes       String?
  
  // Citizen Verification / Dispute
  disputeReason         String?
  disputePhotoUrl       String?
  escalatedToSupervisor Boolean       @default(false)
  
  upvoteCount           Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  observations          Observation[]
  auditLogs             AuditLog[]
}

model Observation {
  id              String   @id @default(cuid())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName      String
  authorRole      String   @default("NEIGHBOR") // NEIGHBOR, COMMUNITY_VOLUNTEER
  comment         String
  photoUrl        String?
  observationType String   @default("STATUS_UPDATE") // VERIFICATION, STATUS_UPDATE, ADDITIONAL_PHOTO, CORRECTION
  createdAt       DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sourceLabel String   // Resident Input, AI Structured, Official Update, Reviewer Verified, Proof-of-Work Submitted, Citizen Disputed, Citizen Verified
  action      String   // TICKET_CREATED, AI_ANALYSIS_COMPLETED, WARD_ROUTED, OFFICER_ASSIGNED, PROVISIONAL_RESOLUTION, DISPUTED, CLOSED
  actorName   String
  actorRole   String
  details     String
  timestamp   DateTime @default(now())
}
