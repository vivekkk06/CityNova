// This is your Prisma schema file for CityNova
// Configured with SQLite for zero-friction local execution, with easy switch to Postgres/PostGIS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  username    String?   @unique
  phoneHash   String?
  aadhaarHash String?   @unique
  state       String?
  cityId      String?
  city        City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  email       String?
  role        String    @default("CITIZEN")
  sessions    Session[]
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
}

model City {
  id            String   @id @default(cuid())
  name          String
  state         String
  normalizedKey String   @unique
  centerLat     Float
  centerLng     Float
  users         User[]
  tickets       Ticket[]
  createdAt     DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Ticket {
  id                  String @id @default(cuid())
  caseId              String @unique
  title               String
  description         String
  category            String // e.g. Pothole & Road Damage, Water Leakage / Pipe Burst
  urgency             String @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  plainLanguageRights String
  status              String @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, PROVISIONALLY_RESOLVED, RESOLVED, DISPUTED, CLOSED

  // Geolocation
  latitude           Float
  longitude          Float
  addressDescription String

  // Relations
  cityId     String?
  city       City?   @relation(fields: [cityId], references: [id], onDelete: SetNull)
  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  // Citizen Info (Masked in public view)
  citizenName  String
  citizenPhone String

  // Operational details
  publicCommitmentDate DateTime
  slaDeadline          DateTime

  // Multimodal initial uploads
  initialPhotoUrl String?
  initialAudioUrl String?

  // Proof of Work (Two-Stage Resolution Gate)
  resolutionPhotoUrl  String?
  resolutionGpsLat    Float?
  resolutionGpsLng    Float?
  resolutionTimestamp DateTime?
  resolutionNotes     String?

  // Citizen Verification / Dispute
  disputeReason   String?
  disputePhotoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
