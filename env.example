# Copy this file to .env before running the app.

# SQLite database (relative to the prisma folder). Keep as is.
DATABASE_URL="file:./dev.db"

# REQUIRED: any random string of 32+ characters. Used to sign login sessions.
CITYNOVA_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# OPTIONAL: AI features. The app still works without these.
# GEMINI_API_KEY=""
# GEMINI_MODEL=""
