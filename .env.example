# ==============================================================================
# CityNova Civic Platform - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL with PostGIS)
# ------------------------------------------------------------------------------
# When running inside Docker Compose (container-to-container network):
DATABASE_URL="postgresql://citynova:citynova_secure_password@postgres:5432/citynova_db?schema=public"

# For host development connecting to Dockerized PostgreSQL (host port 5433):
# DATABASE_URL="postgresql://citynova:citynova_secure_password@localhost:5433/citynova_db?schema=public"

# For zero-setup local SQLite development outside Docker:
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. Application & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Credentials for Docker Compose
POSTGRES_USER=citynova
POSTGRES_PASSWORD=citynova_secure_password
POSTGRES_DB=citynova_db
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 3. Database Initialization & Seeding
# ------------------------------------------------------------------------------
# Automatically seeds Ponda Municipal Council wards, departments & tickets on first startup
SEED_DB=true
FORCE_SEED=false

# ------------------------------------------------------------------------------
# 4. Storage Configuration
# ------------------------------------------------------------------------------
# Storage driver: 'local' (filesystem /uploads) or 's3' (MinIO / AWS S3)
STORAGE_DRIVER=local

# MinIO / S3 Settings (active if STORAGE_DRIVER=s3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=citynova-uploads

# ------------------------------------------------------------------------------
# 5. AI Multimodal Triage (Optional)
# ------------------------------------------------------------------------------
# OpenAI API key for Konkani/Marathi speech-to-text & Vision triage.
# If left empty, CityNova operates fully offline with built-in heuristic rule-engine.
OPENAI_API_KEY=

